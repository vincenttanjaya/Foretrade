# The Docker settings, with comments, are in the root .env.example; every variable the API
# reads is in docs/API-CONTRACT.md §5.
# This short file runs the API outside Docker (it has no .env loader):
#   set -a; source .env; set +a; go run ./cmd/api
# Local boots keep the shared live paper desk paused. Omit or set on only deliberately.
LIVE_ARENA=off
PORT=8080
DATABASE_URL=postgres://trade@localhost:55432/trade?sslmode=disable
# Encrypts the keys saved in the admin console's Settings: openssl rand -hex 32
SECRET_KEY=
# The AI provider is picked in the admin console's Settings. Setting AI_PROVIDER
# (with AI_MODEL and AI_API_KEY) fixes it from the environment instead.
# AI_PROVIDER=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
COOKIE_SECURE=false
AI_DAILY_CREDITS=500
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me
DEMO_NAME="Demo Investor"
# Bootstrap admin for the admin console (password ≥ 12 characters, email ≠ DEMO_EMAIL).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too-please
